principal {
    c, d: car;
    i: int;
} {
    c = 'A';
    d = c;
    escreva c; escreva d; novalinha;
    escreva 'x'; escreva '\t'; escreva 'y'; novalinha;
    escreva c == d; escreva c < 'B'; escreva c != 'A'; novalinha;
    leia i;
    escreva i + 1; novalinha;
    leia c;
    escreva c; novalinha;
    escreva "aspas \" e barra \\ ok"; novalinha;
}
