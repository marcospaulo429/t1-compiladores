principal {
    a, b, c: int;
} {
    a = 7;
    b = 3;
    escreva a + b; novalinha;
    escreva a - b; novalinha;
    escreva a * b; novalinha;
    escreva a / b; novalinha;
    escreva a + b * 2; novalinha;
    escreva (a + b) * 2; novalinha;
    escreva -a + 10; novalinha;
    c = a = b + 1;
    escreva c; novalinha;
    escreva a; novalinha;
    escreva 100 / 5 / 2; novalinha;
    escreva 10 - 4 - 3; novalinha;
}
