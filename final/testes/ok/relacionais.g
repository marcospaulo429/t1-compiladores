principal {
    x: int;
} {
    x = 5;
    escreva x < 6; escreva x > 6; escreva x <= 5; escreva x >= 6;
    escreva x == 5; escreva x != 5; novalinha;
    escreva !x; escreva !0; escreva !(!x); novalinha;
    escreva 1 || 0; escreva 0 || 0; escreva 1 & 1; escreva 1 & 0; novalinha;
    escreva 3 & 4; escreva 0 || 7; novalinha;
}
